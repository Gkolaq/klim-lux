---
import Layout from '../../layouts/Layout.astro';
import LibraryEditor from '../../components/LibraryEditor.astro';
import {env} from 'cloudflare:workers';
import {editor,HttpError} from '../../server/auth';
let account: {id:string;email:string}|null=null;
let denied=false;
try{account=editor(Astro.request,env.EDITOR_EMAILS);}catch(error){denied=error instanceof HttpError&&error.status===403;Astro.response.status=denied?403:401;}
---
<Layout title="Панель редактирования — Klim & Co" description="Управление текстами и фотографиями сайта Klim & Co." noindex admin>
  {!account?<section class="admin-login wrap"><p class="eyebrow">ПАНЕЛЬ ВЛАДЕЛЬЦА</p><h1>{denied?'Доступ ограничен.':'Редактировать сайт.'}</h1><p>{denied?'Войдите в аккаунт ChatGPT владельца сайта. Другие аккаунты не могут изменять материалы.':'Войдите через ChatGPT в аккаунт владельца. Здесь можно менять тексты, контакты и фотографии.'}</p><a class="button button-gold" href={denied?'/signout-with-chatgpt?return_to=%2Fadmin%2F':'/signin-with-chatgpt?return_to=%2Fadmin%2F'} target="_top">{denied?'Сменить аккаунт':'Войти через ChatGPT'}</a><a class="text-link" href="/">Вернуться на сайт</a></section>:<div class="admin-shell" id="editor-app">
    <header class="admin-heading"><div><p class="eyebrow">KLIM & CO / УПРАВЛЕНИЕ</p><h1>Ваш сайт. Ваши изменения.</h1><p>{account.email}</p></div><div class="admin-actions"><a class="button button-outline" href="/" target="_blank" rel="noopener">Открыть сайт</a><a class="text-link" href="/signout-with-chatgpt?return_to=%2Fadmin%2F" target="_top">Выйти</a></div></header>
    <div class="save-bar"><p id="editor-status" role="status" aria-live="polite">Загружаю содержимое…</p><button class="button button-gold" type="button" id="save-content" disabled>Сохранить и опубликовать</button></div>
    <p class="admin-help">Изменения появляются на сайте после сохранения. Исходные фотографии остаются в архиве. В истории доступны последние 50 сохранений.</p>
    <div class="editor-language"><label>Язык редактируемых текстов<select id="editor-language" disabled><option value="ru">Русский</option><option value="pl">Polski</option><option value="en">English</option></select></label><p id="editor-language-note">Телефон, email, фотографии, даты и видимость общие. Тексты каждого языка редактируются отдельно; сохраняются все языки одной кнопкой.</p></div><div id="editor-loading" class="empty-state"><p>Загружаю тексты и фотографии…</p></div>
    <button id="retry-content" class="button button-outline" type="button" hidden>Повторить загрузку</button>
    <div class="editor-layout" id="editor-layout" hidden><nav class="editor-nav" aria-label="Разделы редактирования"><button type="button" data-section="general" aria-pressed="true">Контакты и главная</button><button type="button" data-section="pages" aria-pressed="false">Страницы</button><button type="button" data-section="services" aria-pressed="false">Услуги</button><button type="button" data-section="materials" aria-pressed="false">Материалы</button><button type="button" data-section="process" aria-pressed="false">Процесс работы</button><button type="button" data-section="works" aria-pressed="false">Фотографии</button><button type="button" data-section="library" aria-pressed="false">Книги</button><button type="button" data-section="backup" aria-pressed="false">Копии и история</button></nav>
      <fieldset id="editor-fields" class="editor-fields"><legend class="sr-only">Содержимое сайта</legend><section data-panel="general" class="editor-panel"><h2 tabindex="-1">Контакты и главная</h2><div id="general-fields"></div></section><section data-panel="pages" class="editor-panel" hidden><h2 tabindex="-1">Страницы</h2><div id="pages-fields"></div></section><section data-panel="services" class="editor-panel" hidden><h2 tabindex="-1">Услуги</h2><div id="services-fields"></div></section><section data-panel="materials" class="editor-panel" hidden><h2 tabindex="-1">Материалы</h2><div id="materials-fields"></div></section><section data-panel="process" class="editor-panel" hidden><h2 tabindex="-1">Процесс работы</h2><div id="process-fields"></div></section><section data-panel="works" class="editor-panel" hidden><h2 tabindex="-1">Фотографии</h2><div class="editor-work-tools"><label>Поиск<input id="work-search" type="search" placeholder="Название или номер"/></label><label>Категория<select id="work-category"><option value="">Все категории</option><option value="upholstery">Перетяжка</option><option value="covers">Чехлы</option><option value="custom">Изготовление</option><option value="mechanisms">Механизмы</option></select></label><label class="button button-outline upload-label">Добавить фотографию<input id="upload-photo" type="file" accept="image/jpeg,image/png,image/webp"/></label></div><p id="editor-work-count"></p><div id="editor-work-grid" class="editor-work-grid"></div><button class="button button-outline" id="more-admin-works" type="button" hidden>Показать ещё</button></section><LibraryEditor/><section data-panel="backup" class="editor-panel" hidden><h2 tabindex="-1">Копии и история</h2><p>При каждом успешном сохранении автоматически создаётся проверяемая копия текстов и настроек для резервного экспорта. JSON-копия содержит тексты всех трёх языков, каталог книг и ссылки на фотографии и PDF; сами файлы хранятся отдельно. Скачивайте копию перед большими изменениями и сохраняйте оригиналы файлов.</p><div class="backup-actions"><button type="button" id="export-content" class="button button-outline">Скачать текущую копию</button><label class="button button-outline upload-label">Загрузить JSON-копию<input id="import-content" type="file" accept="application/json,.json"/></label><button type="button" id="load-history" class="button button-outline">Открыть историю</button></div><p>Загруженная копия или версия сначала появится в панели. Чтобы применить её к сайту, нажмите «Сохранить и опубликовать».</p><div id="history-list"></div></section></fieldset>
    </div>
    <dialog id="work-dialog" class="work-dialog"><form id="work-edit-form"><div class="dialog-heading"><h2>Редактировать работу</h2><button type="button" id="close-work-dialog" aria-label="Закрыть редактор">×</button></div><p id="work-edit-language"></p><img id="work-edit-image" alt="Выбранная фотография"/><input type="hidden" name="id"/><label>Название<input name="title" maxlength="160" required/></label><label>Описание<textarea name="description" rows="4" maxlength="5000"></textarea></label><label>Дата или подпись<input name="date" maxlength="80"/></label><label>Категория<select name="category"><option value="upholstery">Перетяжка</option><option value="covers">Чехлы</option><option value="custom">Изготовление</option><option value="mechanisms">Механизмы</option></select></label><label>Порядок в каталоге (меньше — раньше)<input name="order" type="number" min="0" max="100000" required/></label><label class="check-label"><input name="visible" type="checkbox"/> Показывать на сайте</label><label class="check-label"><input name="featured" type="checkbox"/> В подборке на главной</label><label class="check-label"><input name="hero" type="checkbox"/> Главная фотография сайта</label><p id="work-edit-status" role="status"></p><button class="button button-gold" type="submit">Применить к изменениям</button><p class="form-note">Публикация — общей кнопкой сохранения в панели.</p></form></dialog>
  </div>}
  <script>
    if(document.getElementById('editor-app')) void import('../../scripts/admin');
  </script>
</Layout>
