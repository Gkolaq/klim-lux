---
import { UI } from '../i18n/ui';
import { localePath } from '../i18n/locales';
const locale=Astro.locals.locale,t=UI[locale],href=(path:string)=>localePath(locale,path);
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactBand from '../components/ContactBand.astro';
import {photoStyle} from '../components/photo-style';
import {pageCopy,publicWorks} from '../data/content';
const data=Astro.locals.content,page=pageCopy(data,'services'),works=publicWorks(data);
---
<Layout title={page.seoTitle} description={page.seoDescription} crumbs={[{name:t.services}]}>
  <PageIntro page={page} eyebrow={t.servicesIntro}/>
  <section class="service-list wrap">{data.services.map((s,i)=>{const photo=works.find(w=>w.category===s.category);return <article class="service-row"><div><span class="number">0{i+1}</span><h2><a href={href('/services/'+ s.slug+'/')}>{s.title}</a></h2><p class="lead">{s.lead}</p><p>{s.body}</p><a class="button button-outline" href={href('/services/'+ s.slug+'/')}>{t.serviceDetails}</a></div>{photo&&<a class="service-image" href={href('/services/'+ s.slug+'/')} tabindex="-1" aria-hidden="true"><img class="photo-edge" style={photoStyle(photo)} src={photo.thumbnail} alt="" loading="lazy" width={photo.width} height={photo.height}/></a>}</article>})}</section>
  <section class="copy-section wrap"><p class="eyebrow">{t.beforeWork}</p><h2>{t.clearSolution}</h2><p class="prose">{page.body}</p></section><ContactBand/>
</Layout>
