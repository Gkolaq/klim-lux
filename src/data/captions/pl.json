  "302": {
    "title": "Kanapa z ciemną tapicerką i złocistym ornamentem",
    "description": "Ciemna tapicerka ze złocistym ornamentem podkreśla zaokrąglone podłokietniki i drewniane elementy kanapy. Wzór na oparciu, siedzisku i bokach tworzy wyrazistą kompozycję."
  },
  "303": {
    "title": "Fotel z czerwono-złocistą tapicerką",
    "description": "Rzeźbiona drewniana rama otacza oparcie ozdobione czerwono-złocistym motywem roślinnym. Szerokie pasy na siedzisku uzupełniają ornament i podkreślają klasyczną formę fotela."
  },
  "304": {
    "title": "Malinowa sofa z pikowanym oparciem",
    "description": "Asymetryczna sofa o płynnej linii oparcia, wykończona tapicerką w malinowym kolorze. Głębokie pikowanie, zaokrąglone kształty i poduszka w tym samym odcieniu współgrają z jasnymi drewnianymi nogami."
  },
  "305": {
    "title": "Błękitna kanapa z rzeźbioną drewnianą ramą",
    "description": "Trzyosobowa kanapa z błękitną tapicerką, pikowanym oparciem i oddzielnymi poduszkami siedziska. Ciemna rzeźbiona rama oraz ozdobne wykończenie podkreślają linię oparcia, podłokietników i podstawy."
  },
  "306": {
    "title": "Szara sofa z frędzlami i poduszkami",
    "description": "Sofa ze srebrzystoszarą tapicerką, pikowanym oparciem i dwiema ozdobnymi poduszkami. Frędzle, lamówka i fałdy przy podstawie dopełniają miękkie, zaokrąglone podłokietniki."
  },
  "307": {
    "title": "Fotel z kwiatowym wzorem i wykończeniem w pasy",
    "description": "Klasyczny fotel z ciemną drewnianą ramą i czarno-beżowym motywem kwiatowym na oparciu oraz siedzisku. Tapicerka w pasy na zewnętrznych bokach podłokietników uzupełnia główny wzór."
  },
  "308": {
    "title": "Szary fotel z owalnym oparciem",
    "description": "Szary fotel z owalnym, głęboko pikowanym oparciem. Rzeźbiona drewniana rama, zaokrąglone podłokietniki i ozdobne wykończenie krawędzi tapicerki podkreślają klasyczną sylwetkę mebla."
  },
  "309": {
    "title": "Oliwkowa kanapa z głębokim pikowaniem",
    "description": "Kanapa z oliwkową tapicerką i głębokim pikowaniem oparcia oraz siedziska. Pasy na podłokietnikach i przedniej części podstawy współgrają z widocznymi drewnianymi elementami."
  }
