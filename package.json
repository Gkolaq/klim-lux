{
  "name": "klim-lux",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && tsc --noEmit",
    "build": "astro build && node scripts/prepare-sites-build.mjs",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/mobile-interactions.test.mjs tests/contact-form.test.mjs",
    "test:release": "python3 -m unittest discover -s tests -p 'release_*_test.py'",
    "verify:source": "python3 scripts/verify-source.py",
    "release:smoke": "python3 scripts/release-smoke.py"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@astrojs/cloudflare": "14.3.4",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "drizzle-kit": "0.31.11",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.63.1",
    "wrangler": "$wrangler",
    "sharp": "0.35.5",
    "http-cache-semantics": "4.3.0",
    "esbuild": "0.28.2"
  }
}
